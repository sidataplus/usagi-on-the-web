<% content_for :title, "Admin" %>

<div class="page-head">
  <div class="row">
    <%= lucide_icon "shield", class: "icon icon--lg" %>
    <h1 class="page-head__title" style="margin: 0">Admin</h1>
  </div>
</div>

<div class="grid grid--tiles">
  <% [
    [ "Users", @user_count, "users", admin_users_path ],
    [ "Projects", @project_count, "folder-open", projects_path ],
    [ "Mappings", @mapping_count, "table", nil ]
  ].each do |label, value, icon, path| %>
    <div class="stat">
      <div class="stat__label"><%= label %> <%= lucide_icon icon, class: "icon subtle" %></div>
      <div class="stat__value"><%= number_with_delimiter(value) %></div>
      <% if path %><%= link_to "Manage →", path, class: "small" %><% end %>
    </div>
  <% end %>
</div>

<div class="grid grid--halves" style="margin-block-start: var(--space)">
  <div class="box">
    <h2 class="box__title">Quick links</h2>
    <div class="stack-sm">
      <%= link_to admin_users_path, class: "menu__item" do %>
        <%= lucide_icon "users", class: "icon" %> Manage users & roles
      <% end %>
      <%= link_to admin_audit_logs_path, class: "menu__item" do %>
        <%= lucide_icon "history", class: "icon" %> View audit log
      <% end %>
    </div>
  </div>

  <div class="box">
    <h2 class="box__title">Newest users</h2>
    <div class="stack-sm">
      <% @recent_users.each do |user| %>
        <div class="row">
          <span class="avatar avatar--sm"><%= user.initials %></span>
          <div class="truncate">
            <div class="small"><strong><%= user.display_name %></strong></div>
            <div class="small subtle truncate"><%= user.email %></div>
          </div>
          <span class="badge badge--neutral spacer"><%= user.role_label %></span>
        </div>
      <% end %>
    </div>
  </div>
</div>
