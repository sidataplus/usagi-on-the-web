<% content_for :title, "Users — Admin" %>

<div class="page-head">
  <h1 class="page-head__title">Users</h1>
  <div class="page-head__actions"><%= link_to "Back to admin", admin_root_path, class: "btn btn--plain" %></div>
</div>

<div class="box box--flush">
  <table class="table">
    <thead><tr><th>User</th><th class="num">Role</th></tr></thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td>
            <div class="row">
              <span class="avatar avatar--sm"><%= user.initials %></span>
              <div>
                <div><%= user.display_name %></div>
                <div class="small subtle"><%= user.email %></div>
              </div>
            </div>
          </td>
          <td class="num">
            <% if user == current_user %>
              <span class="badge badge--accent">Admin · you</span>
            <% else %>
              <%= form_with model: [ :admin, user ], method: :patch, local: true,
                    class: "row", style: "justify-content: flex-end; gap: var(--space-sm)" do |f| %>
                <%= f.select :admin, [ [ "Reviewer", false ], [ "Admin", true ] ], { selected: user.admin? },
                      class: "select", style: "inline-size: auto", aria: { label: "Role for #{user.display_name}" } %>
                <%= f.submit "Update", class: "btn btn--sm" %>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
