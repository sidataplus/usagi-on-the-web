<% content_for :title, "Engine jobs" %>

<%= render "shared/project_nav", project: @project, active: :jobs %>

<div class="page-head">
  <div>
    <h1 class="page-head__title">Engine jobs</h1>
    <p class="page-head__subtitle"><%= @project.name %></p>
  </div>
  <div class="page-head__actions secondary-actions">
    <%= link_to project_mappings_path(@project), class: "btn" do %>
      <%= lucide_icon "table", class: "icon" %> Review mappings
    <% end %>
    <%= button_to project_auto_map_path(@project), method: :post, class: "btn" do %>
      <%= lucide_icon "sparkles", class: "icon" %> Suggest candidates
    <% end %>
  </div>
</div>

<section class="job-recovery-lane next-action-panel" aria-label="Job recovery lane">
  <div>
    <div class="eyebrow">Next step · Job recovery lane</div>
    <% if @latest_issue_job.present? %>
      <h2><%= @latest_issue_job.job_type.humanize %></h2>
      <p class="small subtle">
        <%= @latest_issue_job.status.humanize %>
        <% if @latest_issue_job.stage.present? %> · <span class="mono"><%= @latest_issue_job.stage %></span><% end %>
      </p>
      <%= link_to project_engine_job_path(@project, @latest_issue_job), class: "btn btn--primary" do %>
        <%= lucide_icon "triangle-alert", class: "icon" %> Open latest issue
      <% end %>
    <% elsif @running_job.present? %>
      <h2><%= @running_job.job_type.humanize %></h2>
      <p class="small subtle">Running now. Candidate rows will update when results persist.</p>
      <%= link_to project_engine_job_path(@project, @running_job), class: "btn btn--primary" do %>
        <%= lucide_icon "activity", class: "icon" %> Watch progress
      <% end %>
    <% else %>
      <h2>No engine issues</h2>
      <p class="small subtle">Suggestion jobs are clear. Continue reviewing candidate rows.</p>
      <%= link_to project_mappings_path(@project), class: "btn btn--primary" do %>
        <%= lucide_icon "table", class: "icon" %> Review mappings
      <% end %>
    <% end %>
  </div>

  <div class="job-recovery-lane__metrics">
    <% target_job = @latest_issue_job || @running_job || @engine_jobs.first %>
    <% if target_job.present? %>
      <span><strong><%= target_job.total.to_i.positive? ? "#{target_job.processed.to_i}/#{target_job.total.to_i}" : "Not reported" %></strong> progress</span>
      <span><strong><%= pluralize(target_job.failed.to_i, "failed") %></strong></span>
    <% else %>
      <span><strong>0</strong> jobs</span>
    <% end %>
  </div>
</section>

<div class="review-brief quiet-section">
  <div>
    <strong>Suggestion jobs feed the Review workspace.</strong>
    <span class="subtle">Use this page for progress, failures, and retry decisions; candidates appear on mapping rows.</span>
  </div>
  <%= link_to "Open review", project_mappings_path(@project), class: "btn btn--sm" %>
</div>

<details class="details-panel quiet-section">
  <summary>Job table</summary>
  <div class="box--flush">
    <table class="table">
      <thead><tr><th>Type</th><th>Status</th><th>Progress</th><th>Failed</th><th>Idempotency key</th><th>Created</th><th></th></tr></thead>
      <tbody>
        <% @engine_jobs.each do |job| %>
          <tr>
            <td><%= job.job_type.humanize.downcase %></td>
            <td><span class="badge badge--<%= job_state_tone(job.state) %>"><%= job.status.humanize %></span></td>
            <td>
              <% if job.total.to_i.positive? %>
                <%= job.processed.to_i %>/<%= job.total.to_i %>
              <% else %>
                <span class="subtle">Not reported</span>
              <% end %>
            </td>
            <td><%= job.failed.to_i %></td>
            <td class="mono"><%= job.idempotency_key.presence || "—" %></td>
            <td><%= job.created_at.to_fs(:short) %></td>
            <td><%= link_to "Open", project_engine_job_path(@project, job), class: "btn btn--sm" %></td>
          </tr>
        <% end %>
        <% if @engine_jobs.empty? %>
          <tr><td colspan="7" class="subtle" style="text-align: center; padding: var(--space-lg)">No engine jobs yet. Run “Suggest candidates” to generate mapping suggestions.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</details>
