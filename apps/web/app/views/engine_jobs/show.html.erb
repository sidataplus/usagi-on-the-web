<% content_for :title, "Engine job" %>

<%= render "shared/project_nav", project: @project, active: :jobs %>

<div class="page-head">
  <div>
    <h1 class="page-head__title"><%= @engine_job.job_type.humanize %></h1>
    <p class="page-head__subtitle"><%= @project.name %> · <%= @engine_job.id %></p>
  </div>
  <div class="page-head__actions">
    <%= link_to project_mappings_path(@project), class: "btn btn--primary" do %>
      <%= lucide_icon "table", class: "icon" %> Review mappings
    <% end %>
    <%= link_to project_engine_jobs_path(@project), class: "btn" do %>
      <%= lucide_icon "activity", class: "icon" %> All jobs
    <% end %>
  </div>
</div>

<div class="review-brief">
  <div>
    <strong>Candidates appear on mapping rows.</strong>
    <span class="subtle">When this job finishes, continue in Review to compare candidates and approve decisions.</span>
  </div>
  <%= link_to "Review mappings", project_mappings_path(@project), class: "btn btn--sm" %>
</div>

<div class="box stack">
  <dl class="facts">
    <div><dt>Status</dt><dd><span class="badge badge--<%= job_state_tone(@engine_job.state) %>"><%= @engine_job.status.humanize %></span></dd></div>
    <div>
      <dt>Progress</dt>
      <dd>
        <% if @engine_job.total.to_i.positive? %>
          <%= @engine_job.processed.to_i %>/<%= @engine_job.total.to_i %>
        <% else %>
          <span class="subtle">Not reported</span>
        <% end %>
      </dd>
    </div>
    <div><dt>Failed rows</dt><dd><%= @engine_job.failed.to_i %></dd></div>
    <div><dt>Requested by</dt><dd><%= @engine_job.requested_by&.display_name || "System" %></dd></div>
  </dl>

  <details class="details-panel">
    <summary>Technical details</summary>
    <dl class="facts" style="margin-block-start: var(--space-sm)">
      <div><dt>Engine job ID</dt><dd class="mono"><%= @engine_status["id"] || @engine_job.api_job_id || @engine_job.id %></dd></div>
      <div><dt>Stage</dt><dd><%= @engine_job.stage.presence || @engine_status["stage"].presence || "—" %></dd></div>
      <div><dt>Status URL</dt><dd class="mono"><%= @engine_job.status_url.presence || @engine_status["status_url"].presence || "—" %></dd></div>
      <div><dt>Result URL</dt><dd class="mono"><%= @engine_job.result_url.presence || @engine_status["result_url"].presence || "—" %></dd></div>
      <div><dt>Idempotency key</dt><dd class="mono"><%= @engine_job.idempotency_key.presence || "—" %></dd></div>
    </dl>
  </details>
</div>

<% failed_items = Array(@engine_job.error["items"]) %>

<% if failed_items.any? %>
  <div class="box box--flush" style="margin-block-start: var(--space)">
    <div style="padding: var(--space)">
      <strong>Partial failures</strong>
      <p class="small subtle">Successful rows were persisted. Retry after resolving the failed rows or engine issue.</p>
    </div>
    <table class="table">
      <thead>
        <tr>
          <th>Source code</th>
          <th>Code</th>
          <th>Message</th>
          <th>Request ID</th>
        </tr>
      </thead>
      <tbody>
        <% failed_items.first(50).each do |item| %>
          <% item_error = item.fetch("error", {}) %>
          <tr>
            <td class="mono"><%= item["source_code"] || item["q"] || "Not reported" %></td>
            <td><%= item_error["code"] || "ERROR" %></td>
            <td><%= item_error["message"] || item_error.to_json %></td>
            <td class="mono"><%= item_error["request_id"] || "Not reported" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% elsif @engine_job.error.present? %>
  <div class="notice notice--warning" style="margin-block-start: var(--space)">
    <strong><%= @engine_job.error["code"] || "Engine job issue" %></strong>
    <p><%= @engine_job.error["message"] || @engine_job.error.to_json %></p>
  </div>
<% end %>

<% if %w[failed cancelled succeeded_with_errors].include?(@engine_job.state) %>
  <div class="page-actions" style="margin-block-start: var(--space)">
    <%= button_to retry_project_engine_job_path(@project, @engine_job), method: :post, class: "btn btn--primary" do %>
      Retry
    <% end %>
  </div>
<% end %>
