<% content_for :title, "Exports" %>

<%= render "shared/project_nav", project: @project, active: :exports %>

<div class="page-head">
  <div>
    <h1 class="page-head__title">Export reviewed mappings</h1>
    <p class="page-head__subtitle"><%= @project.name %> · Review before exporting so downloads reflect human decisions.</p>
  </div>
  <div class="page-head__actions secondary-actions">
    <%= link_to project_mappings_path(@project), class: "btn" do %>
      <%= lucide_icon "table", class: "icon" %> Review mappings
    <% end %>
  </div>
</div>

<section class="next-action-panel" aria-label="Next export action">
  <div class="next-action-panel__body">
    <div class="eyebrow">Next step · Export readiness</div>
    <h2 class="next-action-panel__title">Review before exporting</h2>
    <p class="next-action-panel__copy">Exports are snapshots of the current mapping review state.</p>
    <div class="next-action-panel__meta">
      <span><%= pluralize(@approved_count, "approved mapping") %></span>
      <span><%= "#{pluralize(@unchecked_count, "unchecked mapping")} #{@unchecked_count == 1 ? "still needs" : "still need"} review" %></span>
      <span><%= pluralize(@candidate_count, "candidate") %> with provenance</span>
    </div>
  </div>

  <%= form_with url: project_exports_path(@project), class: "next-action-panel__actions" do |f| %>
    <div class="field" style="margin: 0">
      <%= label_tag :format_option, "Export format", class: "field__label sr-only" %>
      <%= select_tag :format_option, options_for_select(Export.selectable_formats, "review_csv"), class: "select" %>
    </div>
    <%= f.submit "Create export", class: "btn btn--primary" %>
  <% end %>
</section>

<section class="quiet-section" aria-label="Export supporting details">
  <details class="details-panel">
    <summary>Export readiness</summary>
    <div class="export-readiness" aria-label="Export readiness">
      <div>
        <strong><%= pluralize(@approved_count, "approved mapping") %></strong>
        <p class="small subtle">Human-approved rows are ready for source-to-concept output.</p>
      </div>
      <div>
        <strong><%= "#{pluralize(@unchecked_count, "unchecked mapping")} #{@unchecked_count == 1 ? "still needs" : "still need"} review" %></strong>
        <p class="small subtle">Finish these before sharing final mapping files.</p>
      </div>
      <div>
        <strong><%= pluralize(@candidate_count, "candidate") %> with provenance</strong>
        <p class="small subtle">Candidate provenance exports preserve engine evidence for audit.</p>
      </div>
    </div>
  </details>

  <details class="details-panel">
    <summary>Candidate provenance</summary>
    <p class="small subtle" style="margin: 0">Use candidate CSV or JSONL when reviewers need model scores, methods, warnings, and artifact provenance alongside decisions.</p>
  </details>

  <details class="details-panel">
    <summary>Export history</summary>
    <div class="stack-sm">
      <% @exports.each do |export| %>
        <div class="row-between">
          <div>
            <strong><%= export.format_label %></strong>
            <div class="small subtle"><%= number_with_delimiter(export.row_count) %> rows · <%= time_ago_in_words(export.created_at) %> ago</div>
          </div>
          <div class="row" style="gap: var(--space-sm)">
            <span class="badge badge--<%= job_state_tone(export.state) %>"><%= export.state.humanize %></span>
            <%= link_to "Open", project_export_path(@project, export), class: "btn btn--sm" %>
          </div>
        </div>
      <% end %>
      <% if @exports.empty? %>
        <p class="subtle small">No exports yet. Create one after the review queue has the decisions you need.</p>
      <% end %>
    </div>
  </details>
</section>
