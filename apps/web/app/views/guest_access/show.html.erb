<% content_for :title, "Guest access" %>

<div class="empty prose center" style="margin-inline: auto">
  <div class="empty__art">🐰</div>
  <p class="empty__title">Guest access</p>
  <p class="empty__body">You're viewing with guest pass <span class="mono"><%= @pass_id %></span>.</p>
  <div class="box" style="margin-block-start: var(--space-md); text-align: start">
    <p class="subtle">
      Read-only guest review isn't enabled in this demo yet. It will let invited reviewers open a
      project without an account, scoped to a single pass link.
    </p>
  </div>
  <%= link_to "Go home", root_path, class: "btn" %>
</div>
