<% content_for :title, @import_batch.filename %>

<div class="page-head">
  <div>
    <h1 class="page-head__title"><%= @import_batch.filename %></h1>
    <p class="page-head__subtitle"><%= @project.name %> · <%= @import_batch.source_vocabulary %></p>
  </div>
  <div class="page-head__actions">
    <%= button_to project_auto_map_path(@project), method: :post, class: "btn" do %>
      <%= lucide_icon "sparkles", class: "icon" %> Suggest candidates
    <% end %>
    <%= link_to project_mappings_path(@project), class: "btn btn--primary" do %>
      <%= lucide_icon "table", class: "icon" %> Review mappings
    <% end %>
  </div>
</div>

<div class="grid grid--tiles">
  <div class="stat"><div class="stat__label">Rows</div><div class="stat__value"><%= @import_batch.row_count %></div></div>
  <div class="stat"><div class="stat__label">Accepted</div><div class="stat__value"><%= @import_batch.accepted_count %></div></div>
  <div class="stat"><div class="stat__label">Rejected</div><div class="stat__value"><%= @import_batch.rejected_count %></div></div>
  <div class="stat"><div class="stat__label">Status</div><div class="stat__value" style="font-size: 1.25rem"><%= @import_batch.status.humanize %></div></div>
</div>

<div class="box stack-sm" style="margin-block-start: var(--space)">
  <div class="eyebrow">Review handoff</div>
  <h2 class="box__title" style="margin: 0">Ready for review</h2>
  <p>
    <%= "#{pluralize(@import_batch.accepted_count, "source term")} became #{"a mapping".pluralize(@import_batch.accepted_count)}." %>
    Reviewers can inspect each row, search manually, or run suggestions before approving.
  </p>
  <div class="handoff-metrics" aria-label="Import review handoff metrics">
    <span><strong><%= pluralize(@import_mapping_count, "unchecked mapping") %></strong></span>
    <span><strong><%= pluralize(@import_candidate_count, "saved candidate") %></strong></span>
  </div>
  <div class="action-row">
    <%= link_to project_mappings_path(@project, status: "unchecked"), class: "btn btn--primary" do %>
      <%= lucide_icon "table", class: "icon" %> Review imported terms
    <% end %>
    <%= button_to project_auto_map_path(@project), method: :post, class: "btn" do %>
      <%= lucide_icon "sparkles", class: "icon" %> Suggest candidates
    <% end %>
    <%= link_to project_engine_jobs_path(@project), class: "btn" do %>
      <%= lucide_icon "activity", class: "icon" %> Watch jobs
    <% end %>
  </div>
</div>

<% row_errors = Array(@import_batch.error["row_errors"]) %>
<% if row_errors.any? %>
  <div class="notice notice--warning" style="margin-block-start: var(--space)">
    <strong><%= pluralize(row_errors.size, "row") %> could not be imported.</strong>
    <ul>
      <% row_errors.first(20).each do |row_error| %>
        <li>Row <%= row_error["row_number"] || row_error[:row_number] %>: <%= row_error["message"] || row_error[:message] %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="box box--flush" style="margin-block-start: var(--space)">
  <table class="table">
    <thead><tr><th class="num">Row</th><th>Source code</th><th>Source name</th><th class="num">Freq</th></tr></thead>
    <tbody>
      <% @source_terms.each do |term| %>
        <tr>
          <td class="num"><%= term.row_number %></td>
          <td class="mono"><%= term.source_code %></td>
          <td><%= term.source_name %></td>
          <td class="num"><%= term.source_frequency %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
