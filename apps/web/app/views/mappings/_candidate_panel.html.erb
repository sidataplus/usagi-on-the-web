<%# locals: mapping, candidates, next_id (optional). The frame is the single root
    carrying the id so manual search replaces frame-for-frame (no duplicate id);
    display:block overrides the global turbo-frame display:contents. %>
<%= turbo_frame_tag dom_id(mapping, :candidate_panel), class: "suggest__panel", style: "display: block" do %>
  <div class="suggest__head">
    <h3 class="suggest__title"><%= lucide_icon "sparkles", class: "icon" %> Suggested candidates</h3>
    <div class="suggest__meta">
      <span class="small subtle"><%= pluralize(candidates.size, "saved candidate") %></span>
      <% if mapping.source_term&.mapping_candidates&.exists? %>
        <span class="badge badge--accent">Persisted</span>
      <% end %>
    </div>
  </div>
  <%= render "mappings/candidates", mapping: mapping, candidates: candidates, next_id: local_assigns[:next_id] %>
<% end %>
