<%# locals: mapping, siblings — the decision console: target readout on the left,
    state + decision actions on the right. The "Bar" is the one cockpit layout. %>
<section class="cockpit-bar" aria-label="Current decision">
  <div class="cockpit-bar__target truncate">
    <span class="eyebrow"><%= lucide_icon "target", class: "icon icon--sm" %> Mapped target</span>
    <% if mapping.mapped? %>
      <strong class="cockpit-bar__concept truncate"><%= mapping.concept_name %></strong>
      <span class="cockpit-bar__coords">
        <% if mapping.vocabulary_id.present? %><span class="tag"><%= mapping.vocabulary_id %></span><% end %>
        <% if mapping.concept_class_id.present? %><span class="tag tag--quiet"><%= mapping.concept_class_id %></span><% end %>
        <span class="mono">#<%= mapping.concept_id %></span>
        <% if mapping.concept_code.present? %><span class="mono"><%= mapping.concept_code %></span><% end %>
      </span>
    <% else %>
      <span class="cockpit-bar__empty"><%= lucide_icon "scan-search", class: "icon icon--sm" %> No target yet — choose a candidate below.</span>
    <% end %>
  </div>

  <div class="cockpit-bar__controls">
    <div class="cockpit-bar__state">
      <%= status_badge(mapping) %>
      <%= form_with model: mapping, url: mapping_path(mapping), method: :patch, class: "cockpit-bar__equivalence" do |f| %>
        <%= f.label :equivalence, "Equivalence", class: "sr-only" %>
        <%= f.select :equivalence, Mapping::EQUIVALENCE_LABELS.map { |k, v| [ v, k ] }, { include_blank: "Equivalence" }, class: "select select--sm" %>
        <%= f.submit "Save", class: "btn btn--sm" %>
      <% end %>
    </div>

    <div class="cockpit-bar__actions">
      <%= render "mappings/decision_actions", mapping: mapping, siblings: siblings %>
    </div>
  </div>
</section>
