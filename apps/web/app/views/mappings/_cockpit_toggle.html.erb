<%# locals: mapping, layout — switch + persist the cockpit layout. %>
<div class="cockpit-toggle" role="group" aria-label="Cockpit layout">
  <%= link_to mapping_path(mapping, layout: "bar"), data: { turbo_frame: "modal" },
        class: "cockpit-toggle__btn #{"is-active" if layout == "bar"}",
        aria: { label: "Decision bar layout", current: ("true" if layout == "bar") } do %>
    <%= lucide_icon "panel-top", class: "icon icon--sm" %> Bar
  <% end %>
  <%= link_to mapping_path(mapping, layout: "hero"), data: { turbo_frame: "modal" },
        class: "cockpit-toggle__btn #{"is-active" if layout == "hero"}",
        aria: { label: "Best-match layout", current: ("true" if layout == "hero") } do %>
    <%= lucide_icon "star", class: "icon icon--sm" %> Best match
  <% end %>
</div>
