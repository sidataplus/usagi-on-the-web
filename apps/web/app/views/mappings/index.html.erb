<% content_for :title, "Review — #{@project.name}" %>

<div class="page-head">
  <div>
    <h1 class="page-head__title">Mapping review</h1>
    <p class="page-head__subtitle">
      <%= link_to @project.name, project_path(@project) %> ·
      <%= number_with_delimiter(@project.total_mappings) %> source codes
    </p>
  </div>
  <div class="page-head__actions secondary-actions">
    <%= link_to manage_project_path(@project), class: "btn" do %>
      <%= lucide_icon "settings", class: "icon" %> Settings
    <% end %>
    <%= button_to project_auto_map_path(@project), method: :post, class: "btn" do %>
      <%= lucide_icon "sparkles", class: "icon" %> Suggest candidates
    <% end %>
    <%= link_to project_export_path(@project, "inline"), data: { turbo_frame: "modal" }, class: "btn" do %>
      <%= lucide_icon "download", class: "icon" %> Export
    <% end %>
  </div>
</div>

<section class="review-lane next-action-panel" aria-label="Review command lane">
  <div class="review-lane__primary">
    <div class="eyebrow">Next step · Review command lane</div>
    <% if @next_review_mapping.present? %>
      <h2><%= @next_review_mapping.source_name %></h2>
      <p class="small subtle">
        <span class="mono"><%= @next_review_mapping.source_code %></span>
        · <%= pluralize(@next_review_mapping.mapping_candidates.count, "saved candidate") %>
        · freq <%= number_with_delimiter(@next_review_mapping.source_frequency) %>
      </p>
      <% if @next_review_candidate.present? %>
        <div class="review-lane__candidate">
          <span class="eyebrow">Best candidate</span>
          <strong><%= @next_review_candidate.concept_name %></strong>
          <span class="small subtle">
            <%= @next_review_candidate.vocabulary_id %>
            <% if @next_review_candidate.domain_id.present? %> · <%= @next_review_candidate.domain_id %><% end %>
            <% if @next_review_candidate.score.present? %> · <%= score_badge(@next_review_candidate.score) %><% end %>
          </span>
        </div>
      <% end %>
      <%= link_to mapping_path(@next_review_mapping), data: { turbo_frame: "modal" }, class: "btn btn--primary" do %>
        <%= lucide_icon "square-pen", class: "icon" %> Open next unchecked
      <% end %>
    <% else %>
      <h2>All mappings reviewed</h2>
      <p class="small subtle">Flagged and invalid rows are still available from the filters below.</p>
      <%= link_to project_exports_path(@project), class: "btn btn--primary" do %>
        <%= lucide_icon "download", class: "icon" %> Export reviewed mappings
      <% end %>
    <% end %>
  </div>

  <div class="review-lane__metrics">
    <div aria-label="<%= number_with_delimiter(@ready_candidate_count) %> ready with candidates">
      <strong><%= number_with_delimiter(@ready_candidate_count) %></strong>
      <span>ready with candidates</span>
    </div>
    <div aria-label="<%= number_with_delimiter(@waiting_suggestion_count) %> waiting on suggestions">
      <strong><%= number_with_delimiter(@waiting_suggestion_count) %></strong>
      <span>waiting on suggestions</span>
    </div>
  </div>

  <div class="review-lane__attention">
    <% if @engine_attention_job.present? %>
      <div class="eyebrow">Engine attention</div>
      <strong><%= @engine_attention_job.status.humanize %></strong>
      <% if @engine_attention_job.error.present? %>
        <p class="small subtle">
          <span class="mono"><%= @engine_attention_job.error["code"] %></span>
          <% if @engine_attention_job.error["message"].present? %> · <%= @engine_attention_job.error["message"] %><% end %>
        </p>
      <% end %>
      <%= link_to project_engine_job_path(@project, @engine_attention_job), class: "btn btn--sm" do %>
        <%= lucide_icon "activity", class: "icon" %> Open job
      <% end %>
    <% else %>
      <div class="eyebrow">Engine attention</div>
      <strong>Clear</strong>
      <p class="small subtle">No failed suggestion run is blocking review.</p>
    <% end %>
  </div>
</section>

<div class="review-brief quiet-section">
  <div>
    <strong><%= @project.drug_domain? ? "Drug mapper" : "Hybrid search" %></strong>
    <span class="subtle">suggestions feed the candidate list; reviewers still decide.</span>
  </div>
  <% if @latest_engine_job.present? %>
    <div class="review-brief__job">
      <%= link_to project_engine_job_path(@project, @latest_engine_job), class: "badge badge--neutral" do %>
        <%= @latest_engine_job.status.humanize %>
      <% end %>
      <span><%= number_with_delimiter(@latest_engine_job.processed) %> of <%= number_with_delimiter(@latest_engine_job.total) %></span>
      <% if @latest_engine_job.failed.positive? %>
        <span><%= pluralize(@latest_engine_job.failed, "failed") %></span>
      <% end %>
      <% if @latest_engine_job.stage.present? %>
        <span class="mono"><%= @latest_engine_job.stage %></span>
      <% end %>
    </div>
  <% else %>
    <span class="subtle">No suggestion run yet.</span>
  <% end %>
</div>

<div data-controller="bulk_select">
  <%= render "mappings/bulk_operations", project: @project %>

  <%= turbo_frame_tag "mappings_table" do %>
    <%= render "mappings/table", project: @project, mappings: @mappings, counts: @counts,
          status: @status, query: @query, sort: @sort, direction: @direction,
          page: @page, total: @total, total_pages: @total_pages %>
  <% end %>
</div>

<details class="details-panel quiet-section">
  <summary>Shortcut help</summary>
  <div class="shortcuts">
    <span class="row" style="gap: var(--space-xs); color: var(--color-text)"><%= lucide_icon "info", class: "icon" %> <strong>Shortcuts</strong> (in detail view)</span>
    <% [ [ "A", "Approve" ], [ "F", "Flag" ], [ "I", "Invalid" ], [ "N", "Next" ], [ "E", "Edit" ], [ "← →", "Prev / next" ] ].each do |key, label| %>
      <span class="shortcuts__item"><kbd><%= key %></kbd> <%= label %></span>
    <% end %>
  </div>
</details>
