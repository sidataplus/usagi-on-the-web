<% content_for :title, "Review — #{@project.name}" %>

<div class="page-head">
  <div>
    <h1 class="page-head__title">Mapping review</h1>
    <p class="page-head__subtitle">
      <%= link_to @project.name, project_path(@project) %> ·
      <%= number_with_delimiter(@project.total_mappings) %> source codes
    </p>
  </div>
  <div class="page-head__actions">
    <%= link_to manage_project_path(@project), class: "btn" do %>
      <%= lucide_icon "settings", class: "icon" %> Settings
    <% end %>
    <%= button_to project_auto_map_path(@project), method: :post, class: "btn" do %>
      <%= lucide_icon "sparkles", class: "icon" %> Suggest candidates
    <% end %>
    <%= link_to project_export_path(@project, "inline"), data: { turbo_frame: "modal" }, class: "btn btn--primary" do %>
      <%= lucide_icon "download", class: "icon" %> Export
    <% end %>
  </div>
</div>

<div class="review-brief">
  <div>
    <strong><%= @project.drug_domain? ? "Drug mapper" : "Hybrid search" %></strong>
    <span class="subtle">suggestions feed the candidate list; reviewers still decide.</span>
  </div>
  <% if @latest_engine_job.present? %>
    <div class="review-brief__job">
      <%= link_to project_engine_job_path(@project, @latest_engine_job), class: "badge badge--neutral" do %>
        <%= @latest_engine_job.status.humanize %>
      <% end %>
      <span><%= number_with_delimiter(@latest_engine_job.processed) %> of <%= number_with_delimiter(@latest_engine_job.total) %></span>
      <% if @latest_engine_job.failed.positive? %>
        <span><%= pluralize(@latest_engine_job.failed, "failed") %></span>
      <% end %>
      <% if @latest_engine_job.stage.present? %>
        <span class="mono"><%= @latest_engine_job.stage %></span>
      <% end %>
    </div>
  <% else %>
    <span class="subtle">No suggestion run yet.</span>
  <% end %>
</div>

<div data-controller="bulk_select">
  <%= render "mappings/bulk_operations", project: @project %>

  <%= turbo_frame_tag "mappings_table" do %>
    <%= render "mappings/table", project: @project, mappings: @mappings, counts: @counts,
          status: @status, query: @query, sort: @sort, direction: @direction,
          page: @page, total: @total, total_pages: @total_pages %>
  <% end %>
</div>

<div class="box" style="margin-block-start: var(--space)">
  <div class="shortcuts">
    <span class="row" style="gap: var(--space-xs); color: var(--color-text)"><%= lucide_icon "info", class: "icon" %> <strong>Shortcuts</strong> (in detail view)</span>
    <% [ [ "A", "Approve" ], [ "F", "Flag" ], [ "I", "Invalid" ], [ "N", "Next" ], [ "E", "Edit" ], [ "← →", "Prev / next" ] ].each do |key, label| %>
      <span class="shortcuts__item"><kbd><%= key %></kbd> <%= label %></span>
    <% end %>
  </div>
</div>
