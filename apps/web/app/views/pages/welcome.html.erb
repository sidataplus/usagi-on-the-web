<% content_for :title, "Usagi on the Web — OMOP concept mapping" %>

<section class="hero">
  <p class="hero__eyebrow">🐰 Vocabulary mapping, made calm</p>
  <h1 class="hero__title">Map your source codes to OMOP standard concepts.</h1>
  <p class="hero__lede">
    Search, review, and approve concept mappings as a team — without the busywork.
    Usagi does what it needs to, and nothing more.
  </p>
  <div class="hero__actions">
    <%= link_to "Browse projects", projects_path, class: "btn btn--primary" %>
    <%= link_to new_project_path, class: "btn" do %>
      <%= lucide_icon "plus", class: "icon" %> New project
    <% end %>
  </div>
</section>

<section class="grid grid--cards" style="margin-block-end: var(--space-xl)">
  <% [
    [ "search", "Hybrid search", "Lexical and semantic retrieval, fused with RRF for precise candidates." ],
    [ "target", "Drug mapper", "THIRAWAT-SapBERT with Tachiom retrieval and deterministic tie-breaking." ],
    [ "users", "Team review", "Approve, flag, comment, and track history together — keyboard-first." ]
  ].each do |icon, title, body| %>
    <div class="box feature">
      <span class="feature__icon"><%= lucide_icon icon, class: "icon" %></span>
      <p class="feature__title"><%= title %></p>
      <p class="feature__body"><%= body %></p>
    </div>
  <% end %>
</section>

<% if @demo_project %>
  <section>
    <div class="row-between wrap" style="margin-block-end: var(--space)">
      <div>
        <h2 style="font-size: 1.3rem">See it in action</h2>
        <p class="subtle small">A few rows from <strong><%= @demo_project.name %></strong>.</p>
      </div>
      <%= link_to "Open project →", project_mappings_path(@demo_project) %>
    </div>

    <div class="box box--flush">
      <table class="table">
        <thead>
          <tr><th>Source</th><th>Target concept</th><th class="num">Score</th><th>Status</th></tr>
        </thead>
        <tbody>
          <% @demo_mappings.each do |mapping| %>
            <tr>
              <td>
                <div class="mono"><%= mapping.source_code %></div>
                <div><%= mapping.source_name %></div>
              </td>
              <td><%= mapping.concept_name || tag.span("Unmapped", class: "subtle") %></td>
              <td class="num"><%= score_badge(mapping.match_score) %></td>
              <td><%= status_badge(mapping) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>
