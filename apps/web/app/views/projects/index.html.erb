<% content_for :title, "Projects" %>

<div class="page-head">
  <div>
    <h1 class="page-head__title">Projects</h1>
    <p class="page-head__subtitle">Your concept mapping projects.</p>
  </div>
  <div class="page-head__actions secondary-actions">
    <%= link_to new_project_path, class: "btn" do %>
      <%= lucide_icon "plus", class: "icon" %> New project
    <% end %>
  </div>
</div>

<% if @projects.any? %>
  <% resume_project = @projects.detect { |p| project_review_stats(@mapping_counts, p.id)[:unchecked].positive? } || @projects.first %>
  <% resume_stats = project_review_stats(@mapping_counts, resume_project.id) %>
  <% has_work = resume_stats[:unchecked].positive? %>
  <section class="next-action-panel" aria-label="Next project action">
    <div class="next-action-panel__body">
      <div class="eyebrow">Next step</div>
      <% if has_work %>
        <h2 class="next-action-panel__title">Continue reviewing</h2>
        <p class="next-action-panel__copy">
          <strong><%= resume_project.name %></strong> has <%= pluralize(resume_stats[:unchecked], "mapping") %> still waiting on a decision.
        </p>
      <% else %>
        <h2 class="next-action-panel__title">Open your latest project</h2>
        <p class="next-action-panel__copy">
          Continue from <strong><%= resume_project.name %></strong>, updated <%= time_ago_in_words(resume_project.updated_at) %> ago.
        </p>
      <% end %>
      <div class="next-action-panel__meta">
        <span><%= resume_stats[:approved] %> of <%= resume_stats[:total] %> approved</span>
        <span><%= resume_stats[:unchecked] %> unchecked</span>
      </div>
    </div>
    <div class="next-action-panel__actions">
      <% if has_work %>
        <%= link_to project_mappings_path(resume_project, status: "unchecked"), class: "btn btn--primary" do %>
          <%= lucide_icon "list-checks", class: "icon" %> Review mappings
        <% end %>
      <% else %>
        <%= link_to project_path(resume_project), class: "btn btn--primary" do %>
          <%= lucide_icon "folder-open", class: "icon" %> Open project
        <% end %>
      <% end %>
      <%= link_to new_project_path, class: "btn" do %>
        <%= lucide_icon "plus", class: "icon" %> New project
      <% end %>
    </div>
  </section>

  <section class="quiet-section" aria-label="All projects">
    <div class="quiet-section__head">
      <h2 class="quiet-section__title">Projects</h2>
    </div>
    <div class="grid grid--cards">
    <% @projects.each do |project| %>
      <% stats = project_review_stats(@mapping_counts, project.id) %>
      <%= link_to project_path(project), class: "box box--link stack-sm" do %>
        <div class="row-between">
          <strong><%= project.name %></strong>
          <%= project_status_badge(project) %>
        </div>
        <p class="subtle small truncate"><%= project.description %></p>

        <div>
          <div class="meter__label">
            <span><%= stats[:approved] %> of <%= stats[:total] %> approved</span>
            <span><%= stats[:completion] %>%</span>
          </div>
          <div class="meter"><div class="meter__fill" style="inline-size: <%= stats[:completion] %>%"></div></div>
        </div>

        <div class="row small subtle" style="gap: var(--space)">
          <span class="row" style="gap: var(--space-xs)" aria-label="<%= pluralize(stats[:flagged], "flagged mapping") %>"><%= lucide_icon "flag", class: "icon" %> <%= stats[:flagged] %></span>
          <span class="row" style="gap: var(--space-xs)" aria-label="Source vocabulary <%= project.source_vocabulary %>"><%= lucide_icon "building-2", class: "icon" %> <%= project.source_vocabulary %></span>
          <span class="spacer"><%= time_ago_in_words(project.updated_at) %> ago</span>
        </div>
      <% end %>
    <% end %>
    </div>
  </section>

  <%= render "shared/pagination", page: @page, total_pages: @total_pages, path_proc: ->(p) { projects_path(page: p) } %>
<% else %>
  <section class="next-action-panel" aria-label="Next project action">
    <div class="next-action-panel__body">
      <div class="eyebrow">Next step</div>
      <h2 class="next-action-panel__title">Create your first project</h2>
      <p class="next-action-panel__copy">Start mapping source codes by setting up the project container first.</p>
    </div>
    <div class="next-action-panel__actions">
      <%= link_to new_project_path, class: "btn btn--primary" do %>
        <%= lucide_icon "plus", class: "icon" %> New project
      <% end %>
    </div>
  </section>
  <section class="quiet-section">
    <p class="subtle small">No projects yet.</p>
  </section>
<% end %>
