<% content_for :title, "Projects" %>

<div class="page-head">
  <div>
    <h1 class="page-head__title">Projects</h1>
    <p class="page-head__subtitle">Your concept mapping projects.</p>
  </div>
  <div class="page-head__actions secondary-actions">
    <%= link_to new_project_path, class: "btn" do %>
      <%= lucide_icon "plus", class: "icon" %> New project
    <% end %>
  </div>
</div>

<% if @projects.any? %>
  <% next_project = @projects.first %>
  <section class="next-action-panel" aria-label="Next project action">
    <div class="next-action-panel__body">
      <div class="eyebrow">Next step</div>
      <h2 class="next-action-panel__title">Open your latest project</h2>
      <p class="next-action-panel__copy">
        Continue from <strong><%= next_project.name %></strong>, updated <%= time_ago_in_words(next_project.updated_at) %> ago.
      </p>
      <div class="next-action-panel__meta">
        <span><%= next_project.approved_count %> of <%= next_project.total_mappings %> approved</span>
        <span><%= next_project.unchecked_count %> unchecked</span>
      </div>
    </div>
    <div class="next-action-panel__actions">
      <%= link_to project_path(next_project), class: "btn btn--primary" do %>
        <%= lucide_icon "folder-open", class: "icon" %> Open project
      <% end %>
      <%= link_to new_project_path, class: "btn" do %>
        <%= lucide_icon "plus", class: "icon" %> New project
      <% end %>
    </div>
  </section>

  <section class="quiet-section" aria-label="All projects">
    <div class="quiet-section__head">
      <h2 class="quiet-section__title">Projects</h2>
    </div>
    <div class="grid grid--cards">
    <% @projects.each do |project| %>
      <%= link_to project_path(project), class: "box box--link stack-sm" do %>
        <div class="row-between">
          <strong><%= project.name %></strong>
          <%= project_status_badge(project) %>
        </div>
        <p class="subtle small truncate"><%= project.description %></p>

        <div>
          <div class="meter__label">
            <span><%= project.approved_count %> of <%= project.total_mappings %> approved</span>
            <span><%= project.completion_percentage %>%</span>
          </div>
          <div class="meter"><div class="meter__fill" style="inline-size: <%= project.completion_percentage %>%"></div></div>
        </div>

        <div class="row small subtle" style="gap: var(--space)">
          <span class="row" style="gap: var(--space-xs)"><%= lucide_icon "flag", class: "icon" %> <%= project.flagged_count %></span>
          <span class="row" style="gap: var(--space-xs)"><%= lucide_icon "building-2", class: "icon" %> <%= project.source_vocabulary %></span>
          <span class="spacer"><%= time_ago_in_words(project.updated_at) %> ago</span>
        </div>
      <% end %>
    <% end %>
    </div>
  </section>

  <%= render "shared/pagination", page: @page, total_pages: @total_pages, path_proc: ->(p) { projects_path(page: p) } %>
<% else %>
  <section class="next-action-panel" aria-label="Next project action">
    <div class="next-action-panel__body">
      <div class="eyebrow">Next step</div>
      <h2 class="next-action-panel__title">Create your first project</h2>
      <p class="next-action-panel__copy">Start mapping source codes by setting up the project container first.</p>
    </div>
    <div class="next-action-panel__actions">
      <%= link_to new_project_path, class: "btn btn--primary" do %>
        <%= lucide_icon "plus", class: "icon" %> New project
      <% end %>
    </div>
  </section>
  <section class="quiet-section">
    <p class="subtle small">No projects yet.</p>
  </section>
<% end %>
