<% content_for :title, "Manage — #{@project.name}" %>

<%= render "shared/project_nav", project: @project, active: :manage %>

<div class="page-head">
  <div>
    <h1 class="page-head__title">Manage project</h1>
    <p class="page-head__subtitle"><%= @project.name %></p>
  </div>
  <div class="page-head__actions">
    <%= link_to "Back to project", project_path(@project), class: "btn btn--plain" %>
  </div>
</div>

<div class="prose stack">
  <%= form_with model: @project, local: true do |f| %>
    <div class="box stack">
      <h2 class="box__title">Settings</h2>
      <div class="field">
        <%= f.label :name, class: "field__label" %>
        <%= f.text_field :name, class: "input" %>
      </div>
      <div class="field">
        <%= f.label :description, class: "field__label" %>
        <%= f.text_area :description, rows: 2, class: "textarea" %>
      </div>
      <div class="grid grid--halves" style="gap: var(--space)">
        <div class="field">
          <%= f.label :mapping_domain, "Mapping domain", class: "field__label" %>
          <%= f.select :mapping_domain, Project::MAPPING_DOMAINS.map { |domain| [ domain, domain ] }, {}, class: "select" %>
          <p class="field__hint">Drug uses the THIRAWAT drug mapper; other domains use hybrid search.</p>
        </div>
        <div class="field">
          <%= f.label :status, class: "field__label" %>
          <%= f.select :status, Project.statuses.keys.map { |s| [ s.humanize, s ] }, {}, class: "select" %>
        </div>
      </div>
      <div class="grid grid--halves" style="gap: var(--space)">
        <div class="field">
          <%= f.label :source_vocabulary, "Source vocabulary", class: "field__label" %>
          <%= f.text_field :source_vocabulary, class: "input" %>
        </div>
        <div class="field">
          <%= f.label :target_vocabularies, "Target vocabularies", class: "field__label" %>
          <%= f.text_field :target_vocabularies, value: @project.target_vocabularies.join(", "), class: "input", placeholder: "e.g. RxNorm, SNOMED" %>
          <p class="field__hint">Comma-separated.</p>
        </div>
      </div>
      <div class="row" style="justify-content: flex-end">
        <%= f.submit "Save settings", class: "btn btn--primary" %>
      </div>
    </div>
  <% end %>

  <div class="box stack">
    <div class="row-between">
      <h2 class="box__title" style="margin: 0">Members</h2>
      <span class="subtle small"><%= pluralize(@memberships.size, "member") %></span>
    </div>
    <div class="box box--flush">
      <table class="table">
        <thead><tr><th>Member</th><th>Role</th><th></th></tr></thead>
        <tbody>
          <% @memberships.each do |membership| %>
            <tr>
              <td>
                <div class="row">
                  <span class="avatar avatar--sm"><%= membership.user.initials %></span>
                  <div>
                    <div><%= membership.user.display_name %></div>
                    <div class="small subtle"><%= membership.user.email %></div>
                  </div>
                </div>
              </td>
              <td>
                <% if membership.owner? %>
                  <span class="badge badge--accent"><%= membership.role_label %></span>
                <% else %>
                  <%= form_with url: project_member_path(@project, membership), method: :patch, class: "row", style: "gap: var(--space-sm)" do %>
                    <%= select_tag :role, options_for_select(assignable_roles, membership.role),
                          class: "select", style: "inline-size: auto", aria: { label: "Role for #{membership.user.display_name}" } %>
                    <%= submit_tag "Update", class: "btn btn--sm" %>
                  <% end %>
                <% end %>
              </td>
              <td class="num">
                <% unless membership.owner? %>
                  <%= button_to project_member_path(@project, membership), method: :delete,
                        class: "btn btn--icon btn--danger",
                        form: { data: { turbo_confirm: "Remove #{membership.user.display_name} from this project?" } },
                        aria: { label: "Remove #{membership.user.display_name}" } do %>
                    <%= lucide_icon "trash-2", class: "icon" %>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= form_with url: project_members_path(@project), method: :post, class: "row wrap", style: "gap: var(--space-sm)" do %>
      <input type="email" name="email" class="input" placeholder="Add member by email…" style="flex: 1; min-inline-size: 14rem" required>
      <%= select_tag :role, options_for_select(assignable_roles, "reviewer"), class: "select", style: "inline-size: auto", aria: { label: "Role for new member" } %>
      <%= submit_tag "Invite", class: "btn" %>
    <% end %>
    <p class="subtle small">Members must already have an account. Inviting adds an existing user by email.</p>
  </div>
</div>
