<% content_for :title, "New project" %>

<div class="page-head">
  <div>
    <h1 class="page-head__title">New project</h1>
    <p class="page-head__subtitle">Name your project and choose what you're mapping. You'll import source terms next.</p>
  </div>
</div>

<%= form_with model: @project, local: true, class: "prose stack" do |f| %>
  <% if @project.errors.any? %>
    <div class="box" style="border-color: var(--color-bad)">
      <strong><%= pluralize(@project.errors.count, "problem") %> to fix:</strong>
      <ul class="stack-sm small" style="margin-block-start: var(--space-xs)">
        <% @project.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div class="box stack">
    <div class="field">
      <%= f.label :name, class: "field__label" %>
      <%= f.text_field :name, class: "input", placeholder: "e.g. EHR Diagnosis Codes 2024" %>
    </div>
    <div class="field">
      <%= f.label :description, class: "field__label" %>
      <%= f.text_area :description, rows: 2, class: "textarea", placeholder: "What are you mapping?" %>
    </div>
  </div>

  <div class="box stack">
    <div>
      <h2 class="box__title">Mapping setup</h2>
      <p class="subtle small">The domain decides how the engine suggests candidates.</p>
    </div>
    <div class="field">
      <%= f.label :mapping_domain, "Mapping domain", class: "field__label" %>
      <%= f.select :mapping_domain, Project::MAPPING_DOMAINS.map { |domain| [ domain, domain ] }, {}, class: "select" %>
      <p class="field__hint">Drug projects use the specialized THIRAWAT drug mapper. Other domains use hybrid lexical + semantic search.</p>
    </div>
    <div class="grid grid--halves" style="gap: var(--space)">
      <div class="field">
        <%= f.label :source_vocabulary, "Source vocabulary", class: "field__label" %>
        <%= f.text_field :source_vocabulary, class: "input", placeholder: "e.g. ICD10CM" %>
      </div>
      <div class="field">
        <%= f.label :target_vocabularies, "Target vocabularies", class: "field__label" %>
        <%= f.text_field :target_vocabularies, value: @project.target_vocabularies.join(", "), class: "input", placeholder: "e.g. RxNorm, SNOMED" %>
        <p class="field__hint">Comma-separated. Leave blank to allow any standard target.</p>
      </div>
    </div>
    <div class="field">
      <%= f.label :vocabulary_version, "Vocabulary version", class: "field__label" %>
      <%= f.text_field :vocabulary_version, class: "input", placeholder: "v5.0 31-AUG-2024" %>
    </div>
  </div>

  <p class="callout row" style="gap: var(--space-sm)">
    <%= lucide_icon "info", class: "icon subtle" %>
    <span class="small subtle">After you create the project, you'll upload a CSV or XLSX and map its columns.</span>
  </p>

  <div class="row" style="justify-content: flex-end; gap: var(--space-sm)">
    <%= link_to "Cancel", projects_path, class: "btn btn--plain" %>
    <%= f.submit "Create project", class: "btn btn--primary" %>
  </div>
<% end %>
