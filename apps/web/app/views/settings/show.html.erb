<% content_for :title, "Settings" %>

<div class="page-head">
  <h1 class="page-head__title">Settings</h1>
</div>

<%= form_with url: settings_path, method: :patch, local: true, class: "prose stack" do %>
  <div class="box stack">
    <h2 class="box__title">Display</h2>
    <p class="subtle small">Dark mode follows your operating system automatically.</p>
    <div class="row-between">
      <div>
        <strong>Rows per page</strong>
        <p class="subtle small">How many mappings to show in the review table.</p>
      </div>
      <select name="preferences[rows_per_page]" class="select" style="inline-size: auto">
        <% [ 25, 50, 100 ].each do |n| %>
          <option value="<%= n %>" <%= "selected" if @prefs["rows_per_page"].to_i == n %>><%= n %></option>
        <% end %>
      </select>
    </div>
  </div>

  <div class="box stack">
    <div>
      <h2 class="box__title" style="margin: 0">Keyboard shortcuts</h2>
      <p class="subtle small">Available while reviewing mappings.</p>
    </div>
    <dl class="facts">
      <% [ [ "A", "Approve" ], [ "F", "Flag" ], [ "I", "Mark invalid" ], [ "N", "Next" ], [ "E", "Edit / open details" ], [ "← →", "Previous / next in detail view" ] ].each do |key, desc| %>
        <div><dt><%= desc %></dt><dd><kbd><%= key %></kbd></dd></div>
      <% end %>
    </dl>
  </div>

  <div class="box stack">
    <h2 class="box__title">Notifications</h2>
    <% [
      [ "email_notifications", "Email notifications", "Activity summaries by email." ],
      [ "assignment_alerts", "Assignment alerts", "When a mapping is assigned to you." ],
      [ "weekly_digest", "Weekly digest", "A weekly roundup of project progress." ]
    ].each do |key, label, desc| %>
      <div class="row-between">
        <div>
          <strong><%= label %></strong>
          <p class="subtle small"><%= desc %></p>
        </div>
        <label class="switch">
          <input type="checkbox" name="preferences[<%= key %>]" value="1" <%= "checked" if @prefs[key] %>>
          <span class="switch__track"></span>
        </label>
      </div>
    <% end %>
  </div>

  <div class="row" style="justify-content: flex-end">
    <%= submit_tag "Save preferences", class: "btn btn--primary" %>
  </div>
<% end %>
