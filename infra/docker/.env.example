# Copy to a local env file or pass with:
# docker compose --env-file infra/docker/.env.example -f infra/docker/docker-compose.yml up -d --build

# Rails public bind for the full-stack compose file.
RAILS_PUBLISH_HOST=127.0.0.1
RAILS_PUBLISH_PORT=3000
APP_HOSTS=localhost,127.0.0.1
FORCE_SSL=false

# Local PostgreSQL container used by rails-web.
POSTGRES_DB=usagi_production
POSTGRES_USER=usagi
POSTGRES_PASSWORD=replace-with-local-postgres-password

# Rails production boot requirements.
SECRET_KEY_BASE=replace-with-at-least-64-random-characters

# Engine auth.
# Local full-stack compose defaults to signed mode so Rails exercises the
# production request path. API-only development compose may still use api_key.
USAGI_API_ENV=development
USAGI_API_AUTH_MODE=signed
USAGI_API_SHARED_SECRET=replace-with-shared-hmac-secret

# Required only when running infra/docker/docker-compose.api.yml in api_key mode.
USAGI_API_KEYS=replace-with-local-api-key

# Optional debug override bind host for published engine ports.
# For an API-only local compute server reachable from DigitalOcean over
# Tailscale, set this to the server's Tailscale 100.x.y.z address and keep host
# firewall rules restricted to the tailnet.
USAGI_PUBLISH_HOST=127.0.0.1
# Host ports for docker-compose.debug.yml. Defaults avoid clashing with native
# usagi-api dev servers that usually bind 8788-8790.
CATALOG_PUBLISH_PORT=28788
SEARCH_PUBLISH_PORT=28789
MAPPER_PUBLISH_PORT=28790

# Engine artifacts are mounted from ../../data into /data in containers.
# Do not commit these generated or externally supplied files.
# data/catalog/catalog.sqlite
# data/search/tantivy/index/
# data/search/sapbert/
# data/models/sapbert/
# data/models/thirawat-sapbert/
# data/mapper/thirawat-drug/
# data/jobs/jobs.sqlite
# data/jobs/results/
